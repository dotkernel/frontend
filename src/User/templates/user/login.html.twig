{% extends '@layout/default.html.twig' %}

{% block title %}Log in{% endblock %}

{% block page_title %}{% endblock %}

{% block body_class %}user-form{% endblock %}

{% block content %}
    <div class="container">
        <div class="row">
            <div class="col-sm-12">
                <div class="sign-in-block">
                    <h3>Log in to your account</h3>

                    {{ messagesPartial('partial::alerts', {}, null, 'user-login') }}

                    {% set dummy = form.prepare() %}
                    {{ form().openTag(form)|raw }}

                    {% set identity = form.get('identity') %}
                    {% set elementPlaceholder = identity.getAttribute('placeholder')|raw %}
                    {% set dummy = identity.setAttribute('placeholder', elementPlaceholder) %}
                    {{ formElement(identity) }}

                    {% set password = form.get('password') %}
                    {% set elementPlaceholder = password.getAttribute('placeholder')|raw %}
                    {% set dummy = password.setAttribute('placeholder', elementPlaceholder) %}
                    {{ formElement(password) }}

                    <div class="checkbox remember-me-checkbox">
                        {% set rememberMe = form.get('rememberMe') %}
                        {% set dummy = rememberMe.setAttribute('id', 'rememberMe') %}
                        <label>
                            {{ formElement(rememberMe) }}
                            Remember me
                        </label>
                    </div>

                    {{ formElement(form.get('userLoginCsrf')) }}

                    {% set submit = form.get('submit') %}
                    {% set submitValue = submit.getValue|raw %}
                    {% set dummy = submit.setAttribute('value', submitValue) %}
                    {{ formSubmit(submit) }}

                    {{ form().closeTag()|raw }}

                    <hr>

                    <p class="forgot-password"><a href="{{ path('account', {action: 'request-reset-password'}) }}" class="text-decoration-none">Forgot password</a></p>
                    <p>You don't have an account?<a href="{{ path('user', {action: 'register'}) }}" class="text-decoration-none">Register</a>!</p>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
