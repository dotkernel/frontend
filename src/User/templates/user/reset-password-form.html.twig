{% extends '@layout/default.html.twig' %}

{% block title %}Reset Password{% endblock %}
{% block page_title %}{% endblock %}

{% block body_class %}user-form{% endblock %}

{% block content %}
    <div class="container">
        <div class="row">
            <div class="col-sm-12">
                <div class="reset-password-block">
                    <h3>New password</h3>

                    {{ messagesPartial('partial::alerts', {}, null, 'reset-password') }}

                    {{ form().openTag(form)|raw }}

                    {{ formElement(form.get('password')) }}

                    {{ formElement(form.get('passwordConfirm')) }}

                    {{ formElement(form.get('userResetPasswordCsrf')) }}

                    {{ formSubmit(form.get('submit')) }}

                    {{ form().closeTag()|raw }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
