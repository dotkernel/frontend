{% extends '@layout/default.html.twig' %}

{% block title %}Password Reset Request{% endblock %}
{% block page_title %}{% endblock %}

{% block body_class %}user-form{% endblock %}

{% block content %}
    <div class="container">
        <div class="row">
            <div class="col-sm-12">
                <div class="request-reset-block">
                    <h3>Request new password</h3>

                    {{ messagesPartial('partial::alerts', {}, null, 'request-reset') }}

                    {% set dummy = form.prepare() %}
                    {{ form().openTag(form)|raw }}

                    {% set identity = form.get('identity') %}
                    {% set elementPlaceholder = identity.getAttribute('placeholder')|raw %}
                    {% set dummy = identity.setAttribute('placeholder', elementPlaceholder) %}
                    {{ formElement(identity) }}

                    {{ formElement(form.get('userRequestResetPasswordCsrf')) }}

                    {% set submit = form.get('submit') %}
                    {% set submitValue = submit.getValue|raw %}
                    {% set dummy = submit.setAttribute('value', submitValue) %}
                    {{ formSubmit(submit) }}

                    {{ form().closeTag()|raw }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
