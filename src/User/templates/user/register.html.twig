{% extends '@layout/default.html.twig' %}

{% block title %}Register{% endblock %}
{% block page_title %}{% endblock %}

{% block body_class %}user-form{% endblock %}

{% block content %}
    <div class="container">
        <div class="row">
            <div class="col-sm-12">
                <div class="register-block">
                    <h3>Register</h3>

                    {{ messagesPartial('partial::alerts', {}, null, 'user-register') }}

                    {% set dummy = form.prepare() %}
                    {{ form().openTag(form)|raw }}

                    {% set details = form.get('detail') %}

                    {% set firstName = details.get('firstName') %}
                    {% set elementPlaceholder = firstName.getAttribute('placeholder')|raw %}
                    {% set dummy = firstName.setAttribute('placeholder', elementPlaceholder) %}
                    {{ formElement(firstName) }}

                    {% set lastName = details.get('lastName') %}
                    {% set elementPlaceholder = lastName.getAttribute('placeholder')|raw %}
                    {% set dummy = lastName.setAttribute('placeholder', elementPlaceholder) %}
                    {{ formElement(lastName) }}

                    {% set identity = form.get('email') %}
                    {% set elementPlaceholder = identity.getAttribute('placeholder')|raw %}
                    {% set dummy = identity.setAttribute('placeholder', elementPlaceholder) %}
                    {{ formElement(identity) }}

                    {% set password = form.get('password') %}
                    {% set elementPlaceholder = password.getAttribute('placeholder')|raw %}
                    {% set dummy = password.setAttribute('placeholder', elementPlaceholder) %}
                    {{ formElement(password) }}

                    {% set passwordConfirm = form.get('passwordConfirm') %}
                    {% set elementPlaceholder = passwordConfirm.getAttribute('placeholder')|raw %}
                    {% set dummy = passwordConfirm.setAttribute('placeholder', elementPlaceholder) %}
                    {{ formElement(passwordConfirm) }}

                    {{ formElement(form.get('userRegisterCsrf')) }}

                    {% set submit = form.get('submit') %}
                    {% set submitValue = submit.getValue|raw %}
                    {% set dummy = submit.setAttribute('value', submitValue) %}
                    {{ formSubmit(submit) }}

                    {{ form().closeTag()|raw }}

                    <hr>
                    <p class="terms">When you sign up for an account, you agree to our <a href="#">terms and conditions</a>.</p>
                    <p>Already registered? <a href="{{ path('user', {action: 'login'}) }}">Log in</a>!</p>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
